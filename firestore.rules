rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper ─────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "iamrosa.soto18@gmail.com";
    }

    // ── Users ───────────────────────────────────────────────────────────────
    // Explore y Matches leen perfiles de otros usuarios → read abierto a auth.
    // El admin puede escribir cualquier campo (aprobar/rechazar verificación).
    // El dueño puede crear/actualizar su perfil con dos restricciones:
    //   1. No puede auto-asignarse isVerified = true.
    //   2. verificationStatus solo puede dejarse como "pending" si lo cambia
    //      (no puede poner "approved" ni "rejected" él mismo).
    match /users/{uid} {
      allow read: if request.auth != null;

      allow delete: if request.auth != null && request.auth.uid == uid;

      allow write: if isAdmin();

      allow create: if request.auth != null
          && request.auth.uid == uid
          && !(request.resource.data.isVerified == true);

      allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.get('isVerified', false) == resource.data.get('isVerified', false)
          && (
               request.resource.data.get('verificationStatus', '') == resource.data.get('verificationStatus', '')
            || request.resource.data.get('verificationStatus', '') == "pending"
          );

      // ── Profile visits (subcollección) ─────────────────────────────────
      // El visitante crea/actualiza su propio doc (una vez al día throttled en cliente).
      // El visitado lee TODAS sus visitas.
      match /profileVisits/{visitorId} {
        allow create, update: if request.auth != null
            && request.auth.uid != uid
            && request.auth.uid == visitorId
            && request.resource.data.visitorId == request.auth.uid;

        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Notifications ────────────────────────────────────────────────────
    // Subcollección notifications/{userId}/items/{itemId}.
    // Cualquier usuario autenticado puede CREAR una notificación para otro
    // (necesario para notificar al otro cuando se acepta un match).
    // Solo el dueño puede leer, actualizar (marcar seen) y borrar las suyas.
    match /notifications/{userId}/items/{itemId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── Products / Prices / Tax rates (Stripe) — lectura pública ───────────
    match /products/{id} {
      allow read: if true;
      match /prices/{id} {
        allow read: if true;
      }
      match /tax_rates/{id} {
        allow read: if true;
      }
    }

    // ── Customers (extensión Stripe) — cada usuario solo ve lo suyo ─────────
    match /customers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /checkout_sessions/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Admin: leer TODAS las subscriptions (collectionGroup query) ─────────
    // Necesario para el panel de AdminDashboard que usa collectionGroup("subscriptions").
    // No entra en conflicto con la regla de customers/{uid}/subscriptions:
    // Firestore aplica OR entre reglas — con la de arriba el dueño lee la suya;
    // con esta el admin lee todas.
    match /{path=**}/subscriptions/{id} {
      allow read: if isAdmin();
    }

    // ── Configuration (uso interno de la extensión Stripe) ──────────────────
    match /configuration/{id} {
      allow read: if false;
    }

    // ── Blocks ───────────────────────────────────────────────────────────────
    // Doc ID: {blockerId}_{blockedId}. Solo el blocker crea y lee sus propios blocks.
    match /blocks/{blockId} {
      allow create: if request.auth != null
          && request.resource.data.blockerId == request.auth.uid;

      allow read: if request.auth != null
          && (resource == null || resource.data.blockerId == request.auth.uid);

      allow delete: if request.auth != null
          && resource.data.blockerId == request.auth.uid;
    }

    // ── Reports ──────────────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede crear un reporte sobre otro.
    // Solo el admin puede leer y actualizar reportes.
    match /reports/{reportId} {
      allow create: if request.auth != null
          && request.resource.data.reporterId == request.auth.uid;

      allow read, update: if isAdmin();
    }

    // ── Likes ────────────────────────────────────────────────────────────────
    // El ID del documento es `{fromUid}_{toUid}`.
    // Solo el dueño puede crear su propio like.
    // Solo los implicados (fromUid o toUid) pueden leerlo (necesario para detectar like mutuo).
    match /likes/{likeId} {
      allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid;

      allow update: if request.auth != null
          && resource.data.fromUid == request.auth.uid;

      allow read: if request.auth != null
          && (resource.data.fromUid == request.auth.uid
           || resource.data.toUid   == request.auth.uid);

      allow delete: if request.auth != null
          && (resource.data.fromUid == request.auth.uid
           || resource.data.toUid   == request.auth.uid);
    }

    // ── Matches ──────────────────────────────────────────────────────────────
    // El ID es `{uidA}_{uidB}` (UIDs ordenados alfabéticamente).
    // Solo los participantes pueden leer, crear o actualizar su propio match.
    // Update es necesario porque setDoc({merge:true}) en un doc existente
    // (creado por Explore cuando ambos se dieron like mutuo) se evalúa como update.
    match /matches/{matchId} {
      allow read: if request.auth != null
          && request.auth.uid in resource.data.users;

      allow create: if request.auth != null
          && request.auth.uid in request.resource.data.users;

      allow update: if request.auth != null
          && request.auth.uid in resource.data.users;

      allow delete: if request.auth != null
          && request.auth.uid in resource.data.users;
    }

    // ── Conversations ────────────────────────────────────────────────────────
    // Solo los participantes pueden leer/escribir la conversación.
    match /conversations/{convId} {
      allow read, update: if request.auth != null
          && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
          && request.auth.uid in request.resource.data.participants;

      allow delete: if request.auth != null
          && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow read: if request.auth != null
            && request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(convId)).data.participants;

        allow create: if request.auth != null
            && request.resource.data.senderId == request.auth.uid
            && request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(convId)).data.participants
            && !(request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(convId)).data.get("hiddenFor", []));

        allow delete: if request.auth != null
            && request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
    }
  }
}
